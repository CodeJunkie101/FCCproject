# Copy this file to ".env" and fill in your own values.
# (Unit 6 — environment variables; .env is gitignored so secrets never ship.)

# --- Server ---
PORT=4000

# --- Database (Unit 4) ---
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/estatehub
# ...or MongoDB Atlas (recommended — see README):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/estatehub

# --- Auth (Unit 6) ---
# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# --- Email automation (Unit 3) — optional ---
# Leave blank to log notifications to the console instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
